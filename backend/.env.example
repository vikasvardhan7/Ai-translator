# Copy to .env in this folder. .env is ignored by Git; never commit real values.

# Frontend address allowed to call the backend (CORS and WebSocket origin check).
FRONTEND_ORIGIN=http://localhost:5173

# Speech recognition and translation (Gemini API free tier).
# Create a key at https://aistudio.google.com and paste it after the = sign. Never commit it.
GEMINI_API_KEY=
# Model to use. See the models your key can use with: python -m scripts.benchmark --list-models
GEMINI_MODEL=
# Voice model for spoken translations (a model ending in -tts). Empty: the browser speaks instead.
GEMINI_TTS_MODEL=
# Model for the assistant (chat, web search, app commands). Empty: GEMINI_MODEL is used.
GEMINI_ASSISTANT_MODEL=
SPEECH_TIMEOUT_SECONDS=30
# true: the host key is needed even from this computer (set it when a proxy other than cloudflared
# forwards requests from this computer without an X-Forwarded-For header).
HOST_KEY_EVERYWHERE=false
# Where cloudflared is, when it is not on the PATH or where winget installs it.
CLOUDFLARED_PATH=
# A public address of your own, when the app is hosted somewhere; replaces the tunnel.
PUBLIC_URL=
# Scheduled meetings (title, time, length, agenda, host name, link; never audio or transcripts)
# are kept in backend/data/meetings.db. To keep them elsewhere, set the full path:
# MEETINGS_FILE=C:\dev\meetings.db
# API keys for other apps (name, first characters, fingerprint, daily limit; never the key itself)
# are kept in backend/data/keys.db. To keep them elsewhere, set the full path:
# KEYS_FILE=C:\dev\keys.db
# Limits per minute and per day. The person running the app is never limited.
KEY_REQUESTS_PER_MINUTE=60
GUEST_REQUESTS_PER_MINUTE=20
GUEST_REQUESTS_PER_DAY=400

# Accounts: people sign up and sign in with their email, a 6-digit code sent by email and a password.
# Codes are sent from a Gmail account through an app password (free, about 500 emails a day):
# turn on 2-Step Verification for that Google account, make an app password at
# https://myaccount.google.com/apppasswords and paste its 16 letters below. Never commit them.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
# 465 uses SSL from the start; any other port (such as 587) uses STARTTLS.
SMTP_PORT=465
# The sender people see. Empty: "Voice Translator <SMTP_USERNAME>".
MAIL_FROM=
# Accounts (email, name, scrambled password, sign-in sessions) are kept in backend/data/accounts.db,
# and Gym Trainer profiles, plans and tracked days in backend/data/trainer.db. To keep them
# elsewhere, set the full paths:
# ACCOUNTS_FILE=C:\dev\accounts.db
# TRAINER_FILE=C:\dev\trainer.db
# Limits for each signed-in person (conversations, assistant, Gym Trainer AI). This computer is
# never limited.
USER_REQUESTS_PER_MINUTE=30
USER_REQUESTS_PER_DAY=300
