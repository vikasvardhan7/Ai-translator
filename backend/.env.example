# Copy to .env in this folder. .env is ignored by Git; never commit real values.

# Frontend address allowed to call the backend (CORS and WebSocket origin check).
FRONTEND_ORIGIN=http://localhost:5173

# Speech recognition and translation (Gemini API free tier).
# Create a key at https://aistudio.google.com and paste it after the = sign. Never commit it.
GEMINI_API_KEY=
# Model to use. See the models your key can use with: python -m scripts.benchmark --list-models
GEMINI_MODEL=gemini-3.5-flash-lite
SPEECH_TIMEOUT_SECONDS=30
