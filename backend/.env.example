# Copy to .env in this folder. .env is ignored by Git; never commit real values.

# Frontend address allowed to call the backend (CORS and WebSocket origin check).
FRONTEND_ORIGIN=http://localhost:5173

# Folder for local data. A relative path is inside the backend folder. Ignored by Git.
DATA_DIR=data

# Save every received utterance as <DATA_DIR>/debug/<utterance_id>.wav.
# Turn on only while testing: it records everything people say to disk.
SAVE_DEBUG_AUDIO=false
