# Copy this file to .env (same folder) and fill in real values.
# .env is ignored by Git. Never commit real keys.

# development | production
APP_ENV=development

# The frontend address allowed to call the backend (CORS).
FRONTEND_ORIGIN=http://localhost:5173

# AI provider keys (not used until the AI pipeline step).
# GEMINI_API_KEY=put_your_key_here
