# Copy to .env in this folder. .env is ignored by Git; never commit real values.

# Frontend address allowed to call the backend (CORS and WebSocket origin check).
FRONTEND_ORIGIN=http://localhost:5173

# Speech recognition and translation (Gemini API free tier).
# Create a key at https://aistudio.google.com and paste it after the = sign. Never commit it.
GEMINI_API_KEY=
# Model to use. See the models your key can use with: python -m scripts.benchmark --list-models
GEMINI_MODEL=
# Voice model for spoken translations (a model ending in -tts). Empty: the browser speaks instead.
GEMINI_TTS_MODEL=
# Model for the assistant (chat, web search, app commands). Empty: GEMINI_MODEL is used.
GEMINI_ASSISTANT_MODEL=
SPEECH_TIMEOUT_SECONDS=30
# true: the host key is needed even from this computer (set it when a proxy other than cloudflared
# forwards requests from this computer without an X-Forwarded-For header).
HOST_KEY_EVERYWHERE=false
# Where cloudflared is, when it is not on the PATH or where winget installs it.
CLOUDFLARED_PATH=
# A public address of your own, when the app is hosted somewhere; replaces the tunnel.
PUBLIC_URL=
