# Settings for the public server. setup.sh copies this file to deploy/.env; fill in that copy
# on the server with: nano .env   It is ignored by Git; never commit real values.

# The web address people open, without https://. With DuckDNS it is <your subdomain>.duckdns.org.
DOMAIN=

# Free address from https://www.duckdns.org: the subdomain you made (without .duckdns.org) and the
# token shown at the top of that page. The server keeps the address pointed at itself.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# Gemini API key from https://aistudio.google.com and the models, the same as in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TTS_MODEL=
GEMINI_ASSISTANT_MODEL=
SPEECH_TIMEOUT_SECONDS=30

# Gmail account and app password that email the sign-up and reset codes, as in backend/.env.
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM=

# Limits for each signed-in person (conversations, assistant, Gym Trainer AI) and each API key.
USER_REQUESTS_PER_MINUTE=30
USER_REQUESTS_PER_DAY=300
KEY_REQUESTS_PER_MINUTE=60
